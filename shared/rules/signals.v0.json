        "(?<![\\p{L}\\p{M}\\p{N}.,])[0-9]+(?:\\.[0-9]+)? ?(?:lakh|lakhs|lac|crore|cr|k|हज़ार|हजार|लाख|करोड़)(?![\\p{L}\\p{M}])",
        "(?<![\\p{L}\\p{M}\\p{N}.,])[0-9][0-9,]{2,}(?![\\p{L}\\p{M}\\p{N}%])"
      ]
    },
    "negation": {
